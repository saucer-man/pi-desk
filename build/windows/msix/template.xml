<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="pi-desk.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Pi Desk Contributors\Pi Desk">
    </Installer>
    <PackageInformation
        PackageName="Pi Desk"
        PackageDisplayName="Pi Desk"
        PublisherName="CN=Pi Desk Contributors"
        PublisherDisplayName="Pi Desk Contributors"
        Version="1.0.1.0"
        PackageDescription="A desktop interface for the Pi coding agent">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dev.pi.desk"
                Description="A desktop interface for the Pi coding agent"
                DisplayName="Pi Desk"
                ExecutableName="pi-desk.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Pi Desk</DisplayName>
            <PublisherDisplayName>Pi Desk Contributors</PublisherDisplayName>
            <Description>A desktop interface for the Pi coding agent</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="pi-desk.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
