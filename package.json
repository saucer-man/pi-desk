{
  "name": "pi-desk-web",
  "version": "2.0.0-dev.2",
  "description": "A local Web coding workspace powered by Pi SDK",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/saucer-man/pi-desk.git" },
  "bin": { "pi-desk": "dist/server.js" },
  "files": [
    "dist/*.js",
    "frontend/dist/",
    "build/remote-helper/artifacts/",
    "internal/workspaceapp/assets/",
    "internal/appservice/resources/pi-desk-todo.ts",
    "internal/appservice/resources/pi-desk-goal.ts",
    "frontend/src/web/dsh/LICENSE.txt",
    "frontend/src/web/dsh/Montserrat-OFL.txt",
    "docs/screenshots/"
  ],
  "publishConfig": { "access": "public" },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "node src/build-helper.ts && node --watch src/server.ts --dev",
    "build": "node src/build-helper.ts && npm run build --workspace frontend && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prepack": "npm run build",
    "test": "npm run build && go test ./internal/remotehelper ./internal/remoteprotocol && node --test src/*.test.ts",
    "check": "npm test"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "node-pty": "1.1.0",
    "playwright-core": "1.64.1",
    "typebox": "1.3.27",
    "ws": "8.22.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.1",
    "typescript": "6.0.3",
    "vite": "6.4.5"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
