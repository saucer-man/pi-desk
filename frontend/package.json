{
  "name": "@pi-desk/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --configLoader native --pool threads",
    "build:dev": "npm run typecheck && vite build --configLoader native --minify false --mode development",
    "build": "npm run typecheck && vite build --configLoader native --mode production",
    "check": "npm run typecheck && npm run test && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/language-data": "6.5.2",
    "@lezer/highlight": "1.2.3",
    "@milkdown/core": "7.22.1",
    "@milkdown/preset-commonmark": "7.22.1",
    "@milkdown/preset-gfm": "7.22.1",
    "@milkdown/utils": "7.22.1",
    "@milkdown/vue": "7.22.1",
    "@tanstack/vue-virtual": "3.13.35",
    "@wailsio/runtime": "3.0.0-beta.5",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "browser-image-compression": "2.0.2",
    "lucide-vue-next": "1.0.0",
    "markdown-it": "15.0.0",
    "pinia": "4.0.2",
    "vue": "3.5.41",
    "vue-i18n": "11.4.8"
  },
  "devDependencies": {
    "@types/markdown-it": "14.1.2",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "happy-dom": "20.11.2",
    "typescript": "6.0.3",
    "vite": "8.0.5",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9"
  }
}
